<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Сеть нужна авторизации, синхронизации, рекламе и платежам. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Сенсорный экран не обязателен: приложение доступно планшетам/ChromeOS с мышью. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Уведомления и будильники -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Вибрация -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Разрешение для RuStore Billing SDK (для Android 11+) -->
    <queries>
        <package android:name="ru.vk.store" />
        <intent>
            <action android:name="ru.rustore.sdk.billingclient.service.BillingService.BIND" />
        </intent>
    </queries>

    <application
        android:name=".MyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BreathingTrainer"
        tools:targetApi="31">

        <!-- Optional SDKs are initialized manually only after the user's privacy choice. -->
        <provider
            android:name="com.yandex.mobile.ads.core.initializer.MobileAdsInitializeProvider"
            tools:node="remove" />
        <provider
            android:name="io.appmetrica.analytics.internal.PreloadInfoContentProvider"
            tools:node="remove" />

        <!-- MainActivity согласно инструкции (singleTop + Deeplink) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.BreathingTrainer"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deeplink для возврата из банковских приложений -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="glazevbreathingpay" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Виджет 4x2 для рабочего стола -->
        <receiver
            android:name=".widget.BreathingAppWidgetProvider"
            android:exported="true"
            android:process=":widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.glazev.breathingtrainer.ACTION_PREV_TECHNIQUE" />
                <action android:name="com.glazev.breathingtrainer.ACTION_NEXT_TECHNIQUE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/breathing_widget_info" />
        </receiver>

        <!-- Обязательные метаданные согласно инструкции -->
        <meta-data
            android:name="console_app_id_value"
            android:value="@string/rustore_app_id" />

        <meta-data
            android:name="sdk_pay_scheme_value"
            android:value="glazevbreathingpay" />

    </application>

</manifest>
